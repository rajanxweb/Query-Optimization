# =============================================================================
# OptiQuery Configuration & Credentials (.env.example)
# =============================================================================

# Server Configuration
PORT=5000
FLASK_DEBUG=True

# Database Configuration (Optional)
# -----------------------------------------------------------------------------
# OptiQuery works completely STANDALONE with built-in mock statistics and tables (t1, t2).
# No database credentials are required to run the application out-of-the-box!
#
# If you wish to connect OptiQuery to a live PostgreSQL database to fetch real
# table statistics and introspect schemas (such as the TPC-H tables from init-tpch.txt),
# fill in either DATABASE_URL or the individual DB_* parameters below:
# -----------------------------------------------------------------------------

# Option A: Connection URI (e.g., local PostgreSQL, Supabase, Neon, RDS)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/optiquery

# Option B: Individual Parameters
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
